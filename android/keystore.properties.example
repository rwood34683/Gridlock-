# Copy to keystore.properties (git-ignored) before building a release bundle.
# Create the keystore once and keep it safe — Google Play ties the app to it forever:
#   keytool -genkey -v -keystore gridlock-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias gridlock
storeFile=/absolute/path/to/gridlock-release.jks
storePassword=CHANGE_ME
keyAlias=gridlock
keyPassword=CHANGE_ME
