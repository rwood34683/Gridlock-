{
  "name": "gridlock-coach",
  "version": "1.0.0",
  "private": true,
  "description": "GRIDLOCK System · powered by UPRA · Coach Edition — paintball coaching and league-ops app",
  "scripts": {
    "postinstall": "node scripts/patch-speech-plugin.js",
    "start": "node scripts/serve.js --open",
    "serve": "node scripts/serve.js",
    "serve:site": "node scripts/serve.js --root site",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js --root dist",
    "sync": "node scripts/native.js sync",
    "native:setup": "node scripts/native.js setup",
    "ios:setup": "node scripts/xcode.js setup",
    "android:setup": "node scripts/native.js setup android --open",
    "open:ios": "node scripts/native.js open ios",
    "open:android": "node scripts/native.js open android",
    "build:android": "node scripts/native.js build android assembleRelease",
    "bundle:android": "node scripts/native.js build android bundleRelease",
    "build:android:debug": "node scripts/native.js build android assembleDebug",
    "browser:install": "playwright-core install chromium",
    "test": "node scripts/run-checks.js functions arrival arrival-custom platform voice-parser voice speech-native",
    "test:server": "node scripts/run-checks.js server",
    "test:devices": "node scripts/run-checks.js devices",
    "test:offline": "node scripts/run-checks.js offline",
    "verify:bunkers": "node scripts/run-checks.js bunkers",
    "loadtest": "node scripts/run-checks.js load",
    "check": "node scripts/run-checks.js",
    "shots": "node scripts/capture-shots.js && node scripts/optimise-shots.js",
    "store": "node scripts/store-assets.js",
    "store:check": "node scripts/store-check.js",
    "site:check": "node scripts/site-check.js",
    "site:artifact": "node scripts/build-artifact-page.js",
    "app:artifact": "node scripts/build-app-artifact.js",
    "icons": "node brand/generate-assets.js",
    "contact": "node scripts/contact.js",
    "test:arrival": "node scripts/run-checks.js arrival",
    "test:arrival-custom": "node scripts/run-checks.js arrival-custom",
    "test:platform": "node scripts/run-checks.js platform",
    "native:check": "node scripts/native-check.js",
    "ios:preflight": "node scripts/xcode.js preflight",
    "build:ios:simulator": "node scripts/xcode.js build",
    "test:voice-parser": "node scripts/run-checks.js voice-parser",
    "test:voice": "node scripts/run-checks.js voice",
    "test:speech-native": "node scripts/run-checks.js speech-native"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-speech-recognition": "8.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright-core": "^1.49.0",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=22"
  }
}
