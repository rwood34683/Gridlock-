{
  "name": "gridlock-coach",
  "version": "1.0.0",
  "private": true,
  "description": "GRIDLOCK System · powered by UPRA · Coach Edition — paintball coaching and league-ops app",
  "scripts": {
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:android": "cd android && ./gradlew assembleRelease",
    "bundle:android": "cd android && ./gradlew bundleRelease",
    "serve": "node scripts/serve.js",
    "shots": "node scripts/capture-shots.js && node scripts/optimise-shots.js",
    "store": "node scripts/store-assets.js",
    "store:check": "node scripts/store-check.js",
    "site:artifact": "node scripts/build-artifact-page.js",
    "app:artifact": "node scripts/build-app-artifact.js",
    "icons": "python3 brand/generate-assets.py",
    "loadtest": "node test/loadtest.js",
    "test": "node test/functions.js",
    "verify:bunkers": "node tools/verify_bunkers.js",
    "test:devices": "node test/devices.js",
    "check": "node test/functions.js && node test/devices.js && node tools/verify_bunkers.js && node test/loadtest.js",
    "contact": "node scripts/contact.js",
    "ios:setup": "npm install && npx cap sync ios && cd ios/App && pod install && cd ../.. && npx cap open ios",
    "android:setup": "npm install && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "playwright-core": "^1.49.0"
  }
}
