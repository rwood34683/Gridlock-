  "digitized": {
    "source_view": "2d",
    "source_file": "images/wcppl_2026_championship_2d.jpg",
    "method": "Printed 10-ft grid detected in the image (16 verticals x 13 horizontals = 15 x 12 cells), giving 9.0 px/ft on both axes. The sheet prints the snake along the top, so each reading is taken in its own frame and turned over (y = 120 - y) into the Gridlock frame, snake at +y. Each bunker is the centre of its own measured paint footprint: red paint plus the near-black cap and shaded face, on a white sheet under a light grey grid. Touching bunkers are split where the drawing joins them: beam joints at the darker joints along the lit band, the centre beam at the centre line, the pieces standing on a beam at its edge.",
    "field_rect_px": {
      "x0": 46,
      "y0": 27,
      "x1": 1396,
      "y1": 1107
    },
    "px_per_ft": {
      "x": 9.0,
      "y": 9.0
    },
    "precision": "This map is 1440 px wide, 9.0 px/ft, so one pixel is 0.11 ft. Coordinates are good to about a fifth of a foot, not to the inch.",
    "mirror_check": "26 mirrored pairs, axis mean 74.98 ft, sd 0.03 ft. The four unpaired bunkers stand on the centre line.",
    "bunker_count": 56,
    "unlabeled": "The map prints no bunker labels. Every name is the kind of inflatable read off its drawn shape and its measured size against the standard book: the cubes as T, the corner blocks and the two stepped centre blocks as GB, the balls and small cans as C, the pyramids and wedges as MD, the caps on the two centre beams as SD, the end-line uprights and the angled corner blocks as Br. The two end-line Br stand half behind the field and are kept where the map draws them; the corner Br are drawn square, because only a beam is drawn at its angle.",
    "tool": "tools/digitize_wcppl_championship.py",
    "footprints": {
      "source": "layouts/images/nxl_2026_midwest_2d.jpg",
      "book": "layouts/bunkers.json",
      "tool": "tools/bunkerbook.py",
      "note": "Positions are measured off this event's own official 2D on its printed 10-ft grid. Footprints are not: a bunker type is one inflatable and does not change size between events, so every footprint comes from layouts/bunkers.json, measured once off the unlabeled Midwest Open 2D at 31.1 px/ft, where there is no printed grid, no label and no watermark to read a bunker into. Each bunker keeps what this map drew as drawn_w_ft and drawn_h_ft, and off_ft is how far the two disagree.",
      "residual_ft": {
        "mean": 1.27,
        "median": 1.18,
        "worst": 4.16,
        "worst_at": "Br at 139.4, 11.2 ft"
      }
    }
